{
  "suite": "ARGUS Synthetic SOC Evaluation",
  "version": "1.0",
  "cases": [
    {
      "id": "DET-001",
      "scenario_id": "scenario-001",
      "category": "attack_classification",
      "description": "Confirmed successful attack is classified as SUCCESS.",
      "expected": {"attack_outcome": "SUCCESS"}
    },
    {
      "id": "DET-002",
      "scenario_id": "scenario-002",
      "category": "false_positive",
      "description": "WAF-blocked exploit without execution is not classified as a successful compromise.",
      "expected": {"attack_outcome": "FAILED"}
    },
    {
      "id": "DET-003",
      "scenario_id": "scenario-003",
      "category": "attack_classification",
      "description": "Successful exploit with execution evidence is classified as SUCCESS.",
      "expected": {"attack_outcome": "SUCCESS"}
    },
    {
      "id": "RESP-001",
      "scenario_id": "scenario-001",
      "category": "response",
      "description": "Confirmed compromise receives a bounded response.",
      "expected": {"response_status": "APPLIED", "containment_status": "SUCCESS"}
    },
    {
      "id": "RESP-002",
      "scenario_id": "scenario-002",
      "category": "response_precision",
      "description": "False positive does not trigger a state-changing response.",
      "expected": {"response_status": "NOT_ATTEMPTED"}
    },
    {
      "id": "RESP-003",
      "scenario_id": "scenario-003",
      "category": "response",
      "description": "Adaptive response eventually contains the active threat.",
      "expected": {"response_status": "APPLIED", "containment_status": "SUCCESS", "active_threat": false}
    },
    {
      "id": "ADAPT-001",
      "scenario_id": "scenario-003",
      "category": "adaptation",
      "description": "Agent detects failed first containment.",
      "expected": {"event": "VERIFICATION_FAILED"}
    },
    {
      "id": "ADAPT-002",
      "scenario_id": "scenario-003",
      "category": "adaptation",
      "description": "Agent detects that containment failed.",
      "expected": {"event": "CONTAINMENT_FAILURE_DETECTED"}
    },
    {
      "id": "ADAPT-003",
      "scenario_id": "scenario-003",
      "category": "adaptation",
      "description": "Agent finds new evidence after the first response fails.",
      "expected": {"event": "NEW_EVIDENCE_FOUND"}
    },
    {
      "id": "ADAPT-004",
      "scenario_id": "scenario-003",
      "category": "adaptation",
      "description": "Agent revises its working hypothesis after verification failure.",
      "expected": {"event": "HYPOTHESIS_REVISED"}
    },
    {
      "id": "ADAPT-005",
      "scenario_id": "scenario-003",
      "category": "adaptation",
      "description": "Agent selects a stronger bounded response.",
      "expected": {"event": "ADAPTIVE_RESPONSE_SELECTED"}
    },
    {
      "id": "VER-001",
      "scenario_id": "scenario-001",
      "category": "verification",
      "description": "Successful first response is verified against the simulated environment.",
      "expected": {"event": "RESPONSE_VERIFIED"}
    },
    {
      "id": "VER-002",
      "scenario_id": "scenario-003",
      "category": "verification",
      "description": "Primary demo contains both failed and successful verification states.",
      "expected": {"events": ["VERIFICATION_FAILED", "RESPONSE_VERIFIED"]}
    },
    {
      "id": "SAFE-001",
      "scenario_id": "scenario-002",
      "category": "safety",
      "description": "False positive remains uncontained because no compromise is confirmed.",
      "expected": {"containment_status": "NOT_ATTEMPTED", "active_threat": false}
    },
    {
      "id": "SAFE-002",
      "scenario_id": "scenario-003",
      "category": "safety",
      "description": "Adaptive host quarantine is reached only after confirmed compromise and failed containment.",
      "expected": {"event": "ADAPTIVE_RESPONSE_SELECTED", "action": "quarantine_host"}
    },
    {
      "id": "CLOSE-001",
      "scenario_id": "scenario-001",
      "category": "final_assessment",
      "description": "Completed investigation produces a final assessment.",
      "expected": {"complete": true, "final_assessment": true}
    },
    {
      "id": "CLOSE-002",
      "scenario_id": "scenario-003",
      "category": "final_assessment",
      "description": "Primary adaptive investigation closes with no active threat.",
      "expected": {"complete": true, "final_assessment": true, "active_threat": false}
    },
    {
      "id": "OBS-001",
      "scenario_id": "scenario-003",
      "category": "observability",
      "description": "Primary demo records an observable investigation timeline with decisions and tool results.",
      "expected": {"min_decisions": 2, "min_tool_results": 2}
    }
  ]
}
